
#include <LiquidCrystal_I2C.h>
#include <Wire.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);

// =================================
// PIN
// =================================

#define tombol 8
#define buzzPin 9
#define sensorIR 7

// Sensor IR biasanya LOW saat mendeteksi objek
const int IR_DETECT = LOW;

// =================================
// VARIABEL ANIMASI STANDBY
// =================================

unsigned long previousMillis = 0;
unsigned long interval = 1000;

bool mataTerbuka = true;

// =================================
// VARIABEL ANIMASI SAPAAN
// =================================

bool objekTerdeteksi = false;
bool tampilanMenyapa = false;

bool mulutSapaanTerbuka = false;

unsigned long previousSapaan = 0;
const unsigned long intervalSapaan = 250;

// =================================
// VARIABEL MODE BERNYANYI
// =================================

bool modeBernyanyi = false;
bool kondisiNyanyi = false;

bool mulutTerbuka = true;

unsigned long previousMulut = 0;
unsigned long intervalMulut = 250;

// =================================
// DATA NADA BUZZER
// =================================

int nada[] = {
  0, 1046, 1174, 1318, 1396, 1567, 1769, 1975,
  2093, 2349, 2637, 2794, 3135, 3520, 3951, 4186, 4699
};

// =================================
// URUTAN LAGU
// =================================

int noteSequence[] = {
  12, 10, 9, 8, 9, 8, 99, 8, 12, 99, 12, 10, 9, 8,
  5, 8, 90, 8, 90, 8, 90, 8, 90, 8, 90, 8, 5, 8, 9,
  8, 11, 10, 8, 11, 10, 11, 12, 90,
  8, 9, 10, 12, 10, 9, 8, 9, 10, 12, 90,
  8, 9, 10, 12, 10, 90, 10, 14, 15, 14, 12, 90,
  15, 14, 12, 90, 12, 8, 12, 90, 12, 11, 10, 9, 90,
  15, 14, 12, 90, 12, 8, 12, 90, 12, 90, 11, 10, 9, 8, 90
};

// =================================
// DURASI NADA
// =================================

int noteDurations[] = {
  500, 1000, 300, 300, 1000, 250, 50, 250,
  200, 50, 200, 900, 500, 2000,
  300, 300, 50, 300, 50, 300, 50, 300,
  50, 300, 50, 300, 300, 300, 1000,
  300, 300, 400, 300, 300, 400, 300, 2000, 200,
  500, 400, 280, 300, 400, 280, 300, 300, 280, 600, 200,
  500, 400, 280, 300, 280, 50, 300, 280, 300, 280, 600, 200,
  300, 300, 280, 50, 300, 300, 280, 50, 300, 300, 300, 600, 200,
  300, 300, 280, 50, 300, 300, 300, 50, 1800, 200, 300, 300, 300, 700, 100
};

// =================================
// VARIABEL BUZZER
// =================================

unsigned long noteStartTime = 0;
unsigned long noteInterval = 0;

int noteIndex = 0;

// Jumlah nada mengikuti array yang paling pendek
const int jumlahSequence =
  sizeof(noteSequence) / sizeof(noteSequence[0]);

const int jumlahDurasi =
  sizeof(noteDurations) / sizeof(noteDurations[0]);

const int totalNotes =
  (jumlahSequence < jumlahDurasi)
  ? jumlahSequence
  : jumlahDurasi;

// =================================
// VARIABEL TOMBOL
// =================================

bool tombolSebelumnya = HIGH;

unsigned long waktuDebounce = 0;
const unsigned long debounceDelay = 50;

// =================================
// SETUP
// =================================

void setup() {
  lcd.init();
  lcd.backlight();
  lcd.clear();

  pinMode(tombol, INPUT_PULLUP);
  pinMode(buzzPin, OUTPUT);

  pinMode(sensorIR, INPUT);

  lcd.setCursor(0, 0);
  lcd.print("prabowo subianto");
}

// =================================
// BACA SENSOR IR
// =================================

void bacaSensorIR() {
  bool statusIR = (digitalRead(sensorIR) == IR_DETECT);

  if (statusIR != objekTerdeteksi) {
    objekTerdeteksi = statusIR;

    if (objekTerdeteksi) {
      tampilkanSapaan();
    }
    else {
      tampilanMenyapa = false;

      lcd.clear();

      // Jika lagu masih berjalan,
      // tampilkan wajah bernyanyi
      if (modeBernyanyi) {
        lcd.setCursor(5, 0);
        lcd.print("0   0");

        lcd.setCursor(7, 1);
        lcd.print("-");
      }
    }
  }
}

// =================================
// TAMPILKAN WAJAH SAPAAN
// =================================

void tampilkanSapaan() {
  tampilanMenyapa = true;

  // Mulut mulai tertutup
  mulutSapaanTerbuka = false;

  previousSapaan = millis();

  lcd.clear();

  // Mata
  lcd.setCursor(5, 0);
  lcd.print("^   ^");


  // Tulisan sapaan
  lcd.setCursor(9, 1);
  lcd.print("haloo");
}

// =================================
// ANIMASI MULUT SAPAAN
// =================================

void animasiSapaan() {
  unsigned long currentMillis = millis();

  if (currentMillis - previousSapaan >= intervalSapaan) {
    previousSapaan = currentMillis;

    mulutSapaanTerbuka = !mulutSapaanTerbuka;

    lcd.setCursor(7, 1);

    if (mulutSapaanTerbuka) {
      lcd.print("o");
    }
    else {
      lcd.print("-");
    }

    // Pastikan tulisan haloo tetap terlihat
    lcd.setCursor(9, 1);
    lcd.print("haloo");
  }
}

// =================================
// ANIMASI MATA STANDBY
// =================================

void mataKedip() {
  unsigned long currentMillis = millis();

  if (currentMillis - previousMillis >= interval) {
    previousMillis = currentMillis;

    lcd.clear();

    if (mataTerbuka) {
      lcd.setCursor(5, 0);
      lcd.print("0   0");

      interval = 1000;
    }
    else {
      lcd.setCursor(5, 0);
      lcd.print("-   -");

      interval = 300;
    }

    lcd.setCursor(7, 1);
    lcd.print("_");

    mataTerbuka = !mataTerbuka;
  }
}

// =================================
// ANIMASI MATA BERNYANYI
// =================================

void mataBernyanyi() {
  unsigned long currentMillis = millis();

  if (currentMillis - previousMulut >= intervalMulut) {
    previousMulut = currentMillis;

    lcd.setCursor(5, 0);
    lcd.print("0   0");

    lcd.setCursor(7, 1);

    if (mulutTerbuka) {
      lcd.print("o");
    }
    else {
      lcd.print("-");
    }

    mulutTerbuka = !mulutTerbuka;
  }
}

// =================================
// BUZZER
// =================================

void bunyi(int nadaKe) {
  if (nadaKe >= 0 &&
      nadaKe < sizeof(nada) / sizeof(nada[0]) &&
      nada[nadaKe] > 0) {

    tone(buzzPin, nada[nadaKe]);
  }
  else {
    noTone(buzzPin);
  }
}

// =================================
// MAINKAN LAGU
// =================================

void mainkanLagu() {
  unsigned long currentMillis = millis();

  if (noteIndex < totalNotes) {

    if (currentMillis - noteStartTime >= noteInterval) {

      bunyi(noteSequence[noteIndex]);

      noteInterval = noteDurations[noteIndex];

      noteIndex++;

      noteStartTime = currentMillis;
    }
  }
  else {
    noTone(buzzPin);
  }
}

// =================================
// MULAI BERNYANYI
// =================================

void mulaiBernyanyi() {
  lcd.clear();

  modeBernyanyi = true;

  mataTerbuka = true;
  mulutTerbuka = true;

  previousMulut = millis();

  noteIndex = 0;
  noteInterval = 0;
  noteStartTime = millis();

  lcd.setCursor(5, 0);
  lcd.print("0   0");

  lcd.setCursor(7, 1);
  lcd.print("-");
}

// =================================
// KEMBALI KE STANDBY
// =================================

void kembaliNormal() {
  noTone(buzzPin);

  modeBernyanyi = false;

  noteIndex = 0;
  noteInterval = 0;

  lcd.clear();

  mataTerbuka = true;
  interval = 1000;
  previousMillis = millis();

  // Mulut kembali tertutup
  mulutSapaanTerbuka = false;
  mulutTerbuka = false;

  previousSapaan = millis();

  // Jika IR masih mendeteksi objek,
  // wajah sapaan standby dengan mulut tertutup
  if (objekTerdeteksi) {
    lcd.setCursor(5, 0);
    lcd.print("^   ^");

    

    lcd.setCursor(9, 1);
    lcd.print("haloo");
  }
}

// =================================
// TOMBOL MODE BERNYANYI
// =================================

void Ktombol() {
  bool tombolSekarang = digitalRead(tombol);

  if (tombolSekarang != tombolSebelumnya) {
    waktuDebounce = millis();
  }

  if (millis() - waktuDebounce > debounceDelay) {

    static bool statusTombolStabil = HIGH;

    if (tombolSekarang != statusTombolStabil) {
      statusTombolStabil = tombolSekarang;

      // Deteksi saat tombol ditekan
      if (statusTombolStabil == LOW) {
        kondisiNyanyi = !kondisiNyanyi;
      }
    }
  }

  tombolSebelumnya = tombolSekarang;
}

// =================================
// LOOP UTAMA
// =================================

void loop() {
  Ktombol();

  bacaSensorIR();

  // =================================
  // MODE BERNYANYI
  // =================================

  if (kondisiNyanyi) {

    if (!modeBernyanyi) {
      mulaiBernyanyi();
    }

    mainkanLagu();

    // Lagu selesai otomatis
    if (noteIndex >= totalNotes) {
      kondisiNyanyi = false;
    }
  }

  // =================================
  // MODE STANDBY
  // =================================

  else {

    if (modeBernyanyi) {
      kembaliNormal();
    }

    // IR mendeteksi objek
    if (objekTerdeteksi) {

      // Animasi mulut sapaan
      animasiSapaan();
    }

    // Tidak ada objek
    else {
      mataKedip();
    }
  }
}
